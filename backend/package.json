{
  "name": "developer-diary-backend",
  "version": "1.0.0",
  "description": "Backend API for the Personal Developer Diary app (Node.js, Express, MongoDB).",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed/createAdmin.js",
